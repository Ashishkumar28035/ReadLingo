PORT=5000
# MongoDB connection URI (Atlas or Local):
# Atlas format: mongodb+srv://<username>:<password>@<cluster-host>/readlingo?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/readlingo
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/readlingo?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=http://localhost:5173
